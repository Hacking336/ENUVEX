# Build output (never commit compiled classes or packaged jars)
backend/target/
target/
*.class
*.jar
*.war
backend/mvn-status/

# Local secrets and environment (see backend/.env.example)
.env
backend/.env
.env.local

# Files uploaded by users at runtime
uploads/

# Scratch / backup files
*.bak
*.orig
cp.txt

# Editors and OS
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Mobile app: dependencies and the assembled www folder are rebuilt by
# "npm run sync" from the shared web pages, so they are not committed.
mobile/node_modules/
mobile/www/
# The Gradle wrapper jar is source for the Android build, not build output.
!mobile/android/gradle/wrapper/gradle-wrapper.jar

# Local review screenshots (not part of the app)
artifacts/
.venv-bcrypt

# Local virtualenv used only to build the presentation deck
.venv-pptx/
