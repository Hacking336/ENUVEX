# Copy this file to backend/.env and fill in the real values.
# backend/.env is git-ignored: never commit real passwords or keys.
# Spring Boot reads backend/.env automatically (see spring.config.import in application.yml).

# --- Supabase Postgres -------------------------------------------------------
# Project "Enuvex" (ovkxwvrtvzqkmqyhdcuh, eu-west-3, PostgreSQL 17).
# Supabase dashboard -> Project Settings -> Database for the password.
# The tables live in their own "enuv" schema, so they are kept apart from the
# default "public" schema and its auth/storage tables.
# Direct connection: use this for Spring Boot, because Flyway needs a real
# session rather than a transaction-pooled one.
DB_URL=jdbc:postgresql://db.ovkxwvrtvzqkmqyhdcuh.supabase.co:5432/postgres?sslmode=require&currentSchema=enuv
# Fallback if your network has no IPv6 route (same host, transaction pooler on
# port 6543). Flyway migrations can fail in transaction mode, so only use this
# for the running app:
# DB_URL=jdbc:postgresql://db.ovkxwvrtvzqkmqyhdcuh.supabase.co:6543/postgres?sslmode=require&currentSchema=enuv

DB_USERNAME=postgres
DB_PASSWORD=your-database-password

# --- JWT signing key ---------------------------------------------------------
# Required: the app refuses to start without it. At least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string
